{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "${description}",
    "authors": [
        "${author}"
    ],
    "contact": {
        "sources": "${sources}",
        "issues": "${sources}/issues"
    },
    "license": "MIT",
    "icon": "assets/${id}/icon.png",
    "environment": "${environment}",
    "entrypoints": {
        "main": [
            "com.stalemated.libtest.SLibTestMod"
        ],
        "client": [
            "com.stalemated.libtest.SLibTestModClient"
        ]
    },
    "mixins": [
        "${id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "minecraft": "${minecraft}",
        "java": ">=${java_version}",
        "fabric-api": "*",
        "s_lib": ">=${slib}"
    }
}
